# Auto-detect text files and normalize line endings to LF
* text=auto

# Explicitly set LF for source files
*.java       text eol=lf
*.kt         text eol=lf
*.swift      text eol=lf
*.dart       text eol=lf
*.ets        text eol=lf
*.ts         text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.json5      text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.md         text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.xml        text eol=lf
*.html       text eol=lf
*.css        text eol=lf

# Binary files — never normalize
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.ico        binary
*.pdf        binary
